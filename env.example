NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Synced onto the Convex deployment by `npm run dev:backend`. Fusion reads it there.
# CLI fusion (`npm run analyze -- --method fusion`) also reads this from the shell.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Convex deployment (`npx convex env set "NAME=value"`) ---
# SITE_URL is the origin the auth cookies are issued for.
# Local: http://127.0.0.1:43123   Production: https://autoace-voice-trial-seven.vercel.app
# SITE_URL=
#
# JWT_PRIVATE_KEY and JWKS come from:
#   eval "$(node scripts/generate-convex-auth-keys.mjs --export)"
# PKCS8 PEM is stored with newlines as spaces. JWKS is {"keys":[{"use":"sig", ...public JWK}]}.
# JWT_PRIVATE_KEY=
# JWKS=
